{
  "apps": [
    {
      "name": "spandana-api",
      "script": "backend/server.js",
      "cwd": "/var/www/spandana",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": "5000"
      },
      "env_file": "/var/www/spandana/backend/.env",
      "error_file": "/var/log/spandana/error.log",
      "out_file": "/var/log/spandana/out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "watch": false,
      "max_restarts": 10,
      "restart_delay": 4000
    }
  ]
}
